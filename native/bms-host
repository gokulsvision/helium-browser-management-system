#!/usr/bin/env python3
"""Native messaging host for Browser Management System.

Reports RSS for the browser that spawned this host, and writes the
hibernation archive to disk so sleeping tabs can be reopened later.
"""
import json
import os
import struct
import subprocess
import sys
import time
from pathlib import Path

ARCHIVE = Path.home() / "Library/Application Support/Browser Management System/hibernated.json"

FAMILIES = (
    "Helium",
    "Google Chrome",
    "Brave Browser",
    "Microsoft Edge",
    "Chromium",
    "Arc",
    "Vivaldi",
    "Dia",
)


def read_msg():
    header = sys.stdin.buffer.read(4)
    if not header:
        sys.exit(0)
    (n,) = struct.unpack("<I", header)
    return json.loads(sys.stdin.buffer.read(n))


def send(obj):
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def proc_name(pid):
    try:
        out = subprocess.check_output(["ps", "-p", str(pid), "-o", "comm="], text=True).strip()
        return out
    except subprocess.CalledProcessError:
        return ""


def proc_ppid(pid):
    try:
        out = subprocess.check_output(["ps", "-p", str(pid), "-o", "ppid="], text=True).strip()
        return int(out)
    except (subprocess.CalledProcessError, ValueError):
        return 0


def detect_family():
    pid = os.getppid()
    for _ in range(8):
        if pid <= 1:
            break
        name = proc_name(pid)
        for family in FAMILIES:
            if family in name:
                return family
        pid = proc_ppid(pid)
    return "Helium"


def rss_for_family(family):
    out = subprocess.check_output(["ps", "-axo", "rss=,comm="], text=True)
    total = 0
    procs = 0
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        name = parts[1]
        if family in name and "bms-host" not in name and "helium-ram" not in name:
            total += int(parts[0])
            procs += 1
    return total, procs


def save_archive(archive):
    ARCHIVE.parent.mkdir(parents=True, exist_ok=True)
    grouped = {}
    for item in archive or []:
        topic = item.get("topic") or "Other"
        grouped.setdefault(topic, []).append(item)
    payload = {
        "cap_gb": 5,
        "policy": (
            "Oldest unused background tabs hibernate first. "
            "Active, pinned, and audible tabs stay. "
            "Sleeping tabs are grouped by topic so you can reopen them later."
        ),
        "updated_at": int(time.time()),
        "count": len(archive or []),
        "topics": grouped,
        "items": archive or [],
    }
    ARCHIVE.write_text(json.dumps(payload, indent=2))
    return str(ARCHIVE)


def main():
    family = detect_family()
    while True:
        msg = read_msg()
        kind = (msg or {}).get("type") or "rss"
        kb, procs = rss_for_family(family)
        rss_mb = round(kb / 1024.0, 1)
        if kind == "save":
            path = save_archive(msg.get("archive") or [])
            send({"ok": True, "path": path, "rss_mb": rss_mb, "procs": procs, "family": family})
            continue
        send({"rss_mb": rss_mb, "procs": procs, "family": family})


if __name__ == "__main__":
    main()
