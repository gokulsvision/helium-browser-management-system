{
  "manifest_version": 2,
  "name": "Browser Management System",
  "version": "1.1.0",
  "description": "Keep Chromium browsers under a 5 GB RAM budget by hibernating oldest tabs and saving them by topic.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Browser Management System",
    "default_popup": "popup.html"
  }
}
